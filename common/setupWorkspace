#!/usr/bin/env bash

set -Eeuo pipefail

# Shared Monutchee workspace setup (one product per workspace).
#
# Invoked by the per-product wrappers, which pass --product:
#   zudemo/zudemo-setupWorkspace       -> --product zudemo
#   kr260demo/kr260demo-setupWorkspace -> --product kr260demo
#   msap1/setupWorkspace               -> --product msap1
#
# Each run creates one product workspace containing three top-level folders:
#   applications/        repo client for APU/RPU/PL and optional WEB projects
#   yocto-build/         independent repo client for Yocto sources
#   runtime-generated/   local generated handoff files
#   openTmux             generated tmux launcher
#   AGENTS.md             optional product workspace guidance
#
# The only per-product differences live in configure_product(); everything
# else is shared.

WORKSPACE_ROOT="${PWD}"

MANIFEST_REPO_URL="${MANIFEST_REPO_URL:-https://github.com/Monutchee/monutchee-manifest.git}"
MANIFEST_BRANCH="${MANIFEST_BRANCH:-main}"
MANIFEST_RAW_REPOSITORY_URL="${MANIFEST_RAW_REPOSITORY_URL:-https://raw.githubusercontent.com/Monutchee/monutchee-manifest}"
# MANIFEST_FILE is retained as a compatibility alias for the Yocto manifest.
MANIFEST_FILE="${MANIFEST_FILE:-}"
APPLICATIONS_MANIFEST_FILE="${APPLICATIONS_MANIFEST_FILE:-}"
YOCTO_MANIFEST_FILE="${YOCTO_MANIFEST_FILE:-${MANIFEST_FILE}}"
MONUTCHEE_PRODUCT="${MONUTCHEE_PRODUCT:-}"

APPLICATIONS_DIR_NAME="${APPLICATIONS_DIR_NAME:-applications}"
YOCTO_DIR_NAME="${YOCTO_DIR_NAME:-yocto-build}"

# Per-product values; filled in by configure_product().
PROJECT_PREFIX=""
TMUX_SESSION=""
YOCTO_BUILD_DIR=""
APU_PROJECT_NAME=""
RPU_PROJECT_NAME=""
PL_PROJECT_NAME=""
WEB_PROJECT_NAME=""
META_MONUTCHEE_BRANCH="${META_MONUTCHEE_BRANCH:-main}"
PRODUCT_BRANCH="${PRODUCT_BRANCH:-main}"
MANIFEST_RAW_BASE_URL="${MANIFEST_RAW_BASE_URL:-${MANIFEST_RAW_REPOSITORY_URL}/${MANIFEST_BRANCH}}"

DO_ALL=false
DO_YOCTO=false
DO_APU=false
DO_RPU=false
DO_PL=false
DO_WEB=false
DO_SCRIPTS=false
AUTO_MODE=false
AUTO_EXISTING_WORKSPACE=false

usage() {
    cat <<'EOF'
Usage:
  setupWorkspace --product PRODUCT [--workspace DIRECTORY] [--branch BRANCH]
  setupWorkspace --product PRODUCT [--workspace DIRECTORY] COMPONENT [COMPONENT...]

Products:
  zudemo       ZuBoard demo workspace
  kr260demo    KR260 demo workspace
  msap1        MSAP1 workspace

Components:
  all       Set up applications, Yocto, and build scripts
  yocto     Synchronize the independent Yocto repo client under yocto-build
  apu       Sync <Prefix>_APU and its pinned Git submodules
  rpu       Sync <Prefix>_RPU and its pinned Git submodules
  pl        Sync <Prefix>_PL
  web       Sync <Prefix>_WEB (MSAP1 only)
  scripts   Install or refresh the build-stage scripts and branch-aware updater

Automatic mode (no COMPONENT):
  Empty workspace       Perform the complete initial setup.
  Existing workspace    Refresh only build scripts, the updater, and AGENTS.md.

Note:
  Initial and explicit component setup also (re)generates an "openTmux"
  launcher in the workspace root. Automatic updates preserve the launcher.
  Run ./openTmux to open a tmux session with windows for yocto-build, the
  product repositories, and the Yocto tftpboot directory.
  After installing scripts, run ./updateBuildScripts.sh to refresh from main,
  or pass --branch BRANCH to test scripts from another manifest branch.

Examples:
  setupWorkspace --product zudemo --workspace ~/work/zudemo all
  setupWorkspace --product msap1 --workspace ~/work/msap1
  setupWorkspace --product msap1 --branch feat/test-workflow
  setupWorkspace --product kr260demo yocto apu
  setupWorkspace --product kr260demo pl rpu
  setupWorkspace --product msap1 --workspace ~/work/msap1 all

Environment overrides:
  MANIFEST_REPO_URL       MANIFEST_BRANCH       MANIFEST_FILE
  MANIFEST_RAW_REPOSITORY_URL
  APPLICATIONS_MANIFEST_FILE YOCTO_MANIFEST_FILE
  APPLICATIONS_DIR_NAME     YOCTO_DIR_NAME
  PRODUCT_BRANCH          META_MONUTCHEE_BRANCH MANIFEST_RAW_BASE_URL
EOF
}

select_all() {
    DO_ALL=true
    DO_YOCTO=true
    DO_APU=true
    DO_RPU=true
    DO_PL=true
    DO_SCRIPTS=true
}

parse_arguments() {
    local selected=0

    while (($# > 0)); do
        case "$1" in
            --product)
                if (($# < 2)); then
                    printf 'Error: --product requires a product name.\n' >&2
                    exit 2
                fi
                MONUTCHEE_PRODUCT="$2"
                shift 2
                ;;

            --product=*)
                MONUTCHEE_PRODUCT="${1#*=}"
                shift
                ;;

            --workspace)
                if (($# < 2)); then
                    printf 'Error: --workspace requires a directory.\n' >&2
                    exit 2
                fi
                WORKSPACE_ROOT="$2"
                shift 2
                ;;

            --workspace=*)
                WORKSPACE_ROOT="${1#*=}"
                shift
                ;;

            --branch)
                if (($# < 2)); then
                    printf 'Error: --branch requires a branch name.\n' >&2
                    exit 2
                fi
                MANIFEST_BRANCH="$2"
                MANIFEST_RAW_BASE_URL="${MANIFEST_RAW_REPOSITORY_URL}/${MANIFEST_BRANCH}"
                shift 2
                ;;

            --branch=*)
                MANIFEST_BRANCH="${1#*=}"
                MANIFEST_RAW_BASE_URL="${MANIFEST_RAW_REPOSITORY_URL}/${MANIFEST_BRANCH}"
                shift
                ;;

            all|ALL|All)
                select_all
                selected=1
                shift
                ;;

            yocto|YOCTO|Yocto)
                DO_YOCTO=true
                selected=1
                shift
                ;;

            apu|APU)
                DO_APU=true
                selected=1
                shift
                ;;

            rpu|RPU)
                DO_RPU=true
                selected=1
                shift
                ;;

            pl|PL)
                DO_PL=true
                selected=1
                shift
                ;;

            web|WEB|Web)
                DO_WEB=true
                selected=1
                shift
                ;;

            scripts|SCRIPTS|Scripts)
                DO_SCRIPTS=true
                selected=1
                shift
                ;;

            -h|--help)
                usage
                exit 0
                ;;

            *)
                printf 'Error: unknown option or component: %s\n\n' "$1" >&2
                usage >&2
                exit 2
                ;;
        esac
    done

    if ((selected == 0)); then
        AUTO_MODE=true
    fi
}

validate_manifest_branch() {
    if [[ ! "${MANIFEST_BRANCH}" =~ ^[A-Za-z0-9._/-]+$ ]]; then
        printf 'Error: invalid manifest branch: %s\n' "${MANIFEST_BRANCH}" >&2
        exit 2
    fi
    if command -v git >/dev/null 2>&1 && \
       ! git check-ref-format --branch "${MANIFEST_BRANCH}" >/dev/null 2>&1; then
        printf 'Error: invalid manifest branch: %s\n' "${MANIFEST_BRANCH}" >&2
        exit 2
    fi
}

workspace_recorded_product() {
    local workspace_marker="${WORKSPACE_ROOT}/.monutchee-workspace"
    local yocto_marker="${WORKSPACE_ROOT}/${YOCTO_DIR_NAME}/.mncos-product"

    if [[ -f "${workspace_marker}" ]]; then
        head -n 1 -- "${workspace_marker}"
    elif [[ -f "${yocto_marker}" ]]; then
        head -n 1 -- "${yocto_marker}"
    fi
}

workspace_is_initialized() {
    [[ -f "${WORKSPACE_ROOT}/.monutchee-workspace" ]] || \
        {
            [[ -d "${WORKSPACE_ROOT}/${APPLICATIONS_DIR_NAME}/.repo" ]] && \
            [[ -d "${WORKSPACE_ROOT}/${YOCTO_DIR_NAME}/.repo" ]]
        }
}

select_automatic_mode() {
    local recorded_product=""

    [[ "${AUTO_MODE}" == true ]] || return 0

    recorded_product="$(workspace_recorded_product)"
    if [[ -n "${recorded_product}" && \
          "${recorded_product}" != "${MONUTCHEE_PRODUCT}" ]]; then
        printf 'Error: workspace belongs to product %s, not %s.\n' \
            "${recorded_product}" "${MONUTCHEE_PRODUCT}" >&2
        exit 2
    fi

    if workspace_is_initialized; then
        AUTO_EXISTING_WORKSPACE=true
        DO_SCRIPTS=true
        MONUTCHEE_SCRIPTS_ONLY_UPDATE=true
        printf 'Existing %s workspace detected; refreshing build scripts and guidance only.\n\n' \
            "${MONUTCHEE_PRODUCT}"
    else
        select_all
        printf 'No initialized %s workspace detected; performing the complete setup.\n\n' \
            "${MONUTCHEE_PRODUCT}"
    fi
}

record_workspace_product() {
    local destination="${WORKSPACE_ROOT}/.monutchee-workspace"
    local staging="${destination}.tmp.$$"

    printf '%s\n' "${MONUTCHEE_PRODUCT}" > "${staging}"
    chmod 0644 -- "${staging}"
    mv -f -- "${staging}" "${destination}"
}

configure_product() {
    case "${MONUTCHEE_PRODUCT}" in
        zudemo|zuboard)
            MONUTCHEE_PRODUCT="zudemo"
            PROJECT_PREFIX="ZuBoardDemo"
            ;;

        kr260demo|kr260)
            MONUTCHEE_PRODUCT="kr260demo"
            PROJECT_PREFIX="KR260Demo"
            ;;

        msap1|MSAP1)
            MONUTCHEE_PRODUCT="msap1"
            PROJECT_PREFIX="MSAP1"
            WEB_PROJECT_NAME="MSAP1_WEB"
            ;;

        "")
            printf 'Error: no product selected. Use --product zudemo, --product kr260demo, or --product msap1.\n' >&2
            exit 2
            ;;

        *)
            printf 'Error: unsupported product: %s\n' "${MONUTCHEE_PRODUCT}" >&2
            exit 2
            ;;
    esac

    TMUX_SESSION="${MONUTCHEE_PRODUCT}"
    YOCTO_BUILD_DIR="build"
    APPLICATIONS_MANIFEST_FILE="${APPLICATIONS_MANIFEST_FILE:-${MONUTCHEE_PRODUCT}/applications.xml}"
    YOCTO_MANIFEST_FILE="${YOCTO_MANIFEST_FILE:-${MONUTCHEE_PRODUCT}/yocto.xml}"
    APU_PROJECT_NAME="${PROJECT_PREFIX}_APU"
    RPU_PROJECT_NAME="${PROJECT_PREFIX}_RPU"
    PL_PROJECT_NAME="${PROJECT_PREFIX}_PL"

    if [[ "${DO_WEB}" == true && -z "${WEB_PROJECT_NAME}" ]]; then
        printf 'Error: product %s does not define a WEB repository.\n' \
            "${MONUTCHEE_PRODUCT}" >&2
        exit 2
    fi
}

create_runtime_directories() {
    mkdir -p -- \
        "${WORKSPACE_ROOT}/runtime-generated/vivado_SDT_out" \
        "${WORKSPACE_ROOT}/runtime-generated/bin_file"

    printf 'Runtime directories are ready:\n'
    printf '  %s\n' "${WORKSPACE_ROOT}/runtime-generated/vivado_SDT_out"
    printf '  %s\n' "${WORKSPACE_ROOT}/runtime-generated/bin_file"
}

install_workspace_guidance() {
    local destination="${WORKSPACE_ROOT}/AGENTS.md"
    local staging="${destination}.tmp.$$"
    local setup_dir=""
    local manifest_root=""
    local local_source=""
    local remote_source="${MANIFEST_RAW_BASE_URL}/${MONUTCHEE_PRODUCT}/AGENTS.md"

    if [[ -n "${BASH_SOURCE[0]:-}" && -f "${BASH_SOURCE[0]}" ]]; then
        setup_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
        manifest_root="$(cd -- "${setup_dir}/.." && pwd -P)"

        # Only treat the script as a manifest checkout when its expected
        # repository layout is present. A downloaded standalone copy should
        # use the remote-source path below.
        if [[ -f "${manifest_root}/common/setupWorkspace" ]]; then
            local_source="${manifest_root}/${MONUTCHEE_PRODUCT}/AGENTS.md"
            if [[ ! -f "${local_source}" ]]; then
                printf 'No workspace AGENTS.md is defined for product %s; skipping.\n' \
                    "${MONUTCHEE_PRODUCT}"
                return 0
            fi
        fi
    fi

    rm -f -- "${staging}"

    if [[ -n "${local_source}" ]]; then
        if ! cp -- "${local_source}" "${staging}"; then
            printf 'Warning: failed to stage workspace guidance from %s; skipping.\n' \
                "${local_source}" >&2
            rm -f -- "${staging}"
            return 0
        fi
    else
        if ! command -v curl >/dev/null 2>&1; then
            printf 'Warning: curl is unavailable; workspace AGENTS.md was not installed.\n' \
                >&2
            return 0
        fi
        if ! curl -fsL "${remote_source}" -o "${staging}"; then
            printf 'No workspace AGENTS.md is available for product %s; skipping.\n' \
                "${MONUTCHEE_PRODUCT}"
            rm -f -- "${staging}"
            return 0
        fi
    fi

    if ! chmod 0644 -- "${staging}"; then
        printf 'Warning: failed to set workspace-guidance permissions; skipping.\n' \
            >&2
        rm -f -- "${staging}"
        return 0
    fi
    if ! mv -f -- "${staging}" "${destination}"; then
        printf 'Warning: failed to install workspace guidance at %s; skipping.\n' \
            "${destination}" >&2
        rm -f -- "${staging}"
        return 0
    fi

    printf 'Workspace guidance is ready:\n'
    printf '  %s\n' "${destination}"
}

create_build_script_updater() {
    local destination="${WORKSPACE_ROOT}/updateBuildScripts.sh"
    local staging="${destination}.tmp.$$"

    {
        printf '#!/usr/bin/env bash\n\n'
        printf 'set -Eeuo pipefail\n\n'
        printf 'PRODUCT=%q\n' "${MONUTCHEE_PRODUCT}"
        printf 'WORKSPACE_ROOT=%q\n' "${WORKSPACE_ROOT}"
        cat <<'BODY'
DEFAULT_BRANCH="main"
RAW_REPOSITORY_URL="https://raw.githubusercontent.com/Monutchee/monutchee-manifest"

usage() {
    cat <<'EOF'
Usage: updateBuildScripts.sh [--branch BRANCH]

Refresh the generated Monutchee build-stage scripts in this workspace.

Options:
  --branch BRANCH  monutchee-manifest branch to install (default: main)
  -h, --help       Show this help
EOF
}

BRANCH="${DEFAULT_BRANCH}"
while (($# > 0)); do
    case "$1" in
        --branch)
            if (($# < 2)); then
                printf 'Error: --branch requires a branch name.\n' >&2
                exit 2
            fi
            BRANCH="$2"
            shift 2
            ;;
        --branch=*)
            BRANCH="${1#*=}"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf 'Error: unknown option: %s\n\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if ! command -v git >/dev/null 2>&1; then
    printf 'Error: git is required to validate the manifest branch.\n' >&2
    exit 1
fi
if [[ ! "${BRANCH}" =~ ^[A-Za-z0-9._/-]+$ ]] || \
   ! git check-ref-format --branch "${BRANCH}" >/dev/null 2>&1; then
    printf 'Error: invalid manifest branch: %s\n' "${BRANCH}" >&2
    exit 2
fi
if ! command -v curl >/dev/null 2>&1; then
    printf 'Error: curl is required to update build scripts.\n' >&2
    exit 1
fi

RAW_BASE_URL="${RAW_REPOSITORY_URL}/${BRANCH}"
SETUP_URL="${RAW_BASE_URL}/common/setupWorkspace"
STAGING="$(mktemp "${TMPDIR:-/tmp}/monutchee-setupWorkspace.XXXXXX")"
trap 'rm -f -- "${STAGING}"' EXIT

printf 'Updating Monutchee build scripts:\n'
printf '  product:   %s\n' "${PRODUCT}"
printf '  branch:    %s\n' "${BRANCH}"
printf '  source:    %s\n' "${SETUP_URL}"
printf '  workspace: %s\n\n' "${WORKSPACE_ROOT}"

if ! curl -fsSL "${SETUP_URL}" -o "${STAGING}"; then
    printf 'Error: failed to download setupWorkspace from branch %s.\n' \
        "${BRANCH}" >&2
    exit 1
fi
if ! bash -n "${STAGING}"; then
    printf 'Error: downloaded setupWorkspace failed Bash syntax validation.\n' >&2
    exit 1
fi

MANIFEST_BRANCH="${BRANCH}" \
MANIFEST_RAW_BASE_URL="${RAW_BASE_URL}" \
MONUTCHEE_SCRIPTS_ONLY_UPDATE=true \
    bash "${STAGING}" \
        --product "${PRODUCT}" \
        --workspace "${WORKSPACE_ROOT}" \
        scripts

printf '\nBuild scripts updated from monutchee-manifest/%s:\n' "${BRANCH}"
printf '  %s/.monutchee-build\n' "${WORKSPACE_ROOT}"
BODY
    } > "${staging}"

    if ! bash -n "${staging}"; then
        printf 'Error: generated build-script updater failed syntax validation.\n' \
            >&2
        rm -f -- "${staging}"
        return 1
    fi
    chmod 0755 -- "${staging}"
    mv -f -- "${staging}" "${destination}"
}

install_build_scripts() {
    local destination="${WORKSPACE_ROOT}/.monutchee-build"
    local staging="${destination}.tmp.$$"
    local setup_dir=""
    local manifest_root=""
    local relative
    local -a files=(
        artifact.py
        build_r5_apps.py
        libbuild.sh
        make_PL.sh
        make_mconf.sh
        make_RPU.sh
        make_yocto.sh
        products/zudemo.conf
        products/kr260demo.conf
        products/msap1.conf
    )

    if [[ -n "${BASH_SOURCE[0]:-}" && -f "${BASH_SOURCE[0]}" ]]; then
        setup_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
        manifest_root="$(cd -- "${setup_dir}/.." && pwd -P)"
    fi

    rm -rf -- "${staging}"
    mkdir -p -- "${staging}/products"
    if [[ -n "${manifest_root}" && -f "${manifest_root}/common/build/libbuild.sh" ]]; then
        cp -a -- "${manifest_root}/common/build/." "${staging}/"
    else
        if ! command -v curl >/dev/null 2>&1; then
            printf 'Error: curl is required to install build scripts from the manifest branch.\n' >&2
            rm -rf -- "${staging}"
            return 1
        fi
        for relative in "${files[@]}"; do
            mkdir -p -- "$(dirname -- "${staging}/${relative}")"
            if ! curl -fsSL \
                "${MANIFEST_RAW_BASE_URL}/common/build/${relative}" \
                -o "${staging}/${relative}"; then
                printf 'Error: failed to fetch build asset: %s\n' "${relative}" >&2
                rm -rf -- "${staging}"
                return 1
            fi
        done
    fi

    chmod +x -- \
        "${staging}/artifact.py" \
        "${staging}/build_r5_apps.py" \
        "${staging}/make_PL.sh" \
        "${staging}/make_mconf.sh" \
        "${staging}/make_RPU.sh" \
        "${staging}/make_yocto.sh"
    rm -rf -- "${destination}"
    mv -- "${staging}" "${destination}"

    for relative in make_PL.sh make_mconf.sh make_RPU.sh make_yocto.sh; do
        {
            printf '#!/usr/bin/env bash\n'
            printf 'set -Eeuo pipefail\n'
            printf 'WORKSPACE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"\n'
            printf 'exec bash "${WORKSPACE_ROOT}/.monutchee-build/%s" --workspace "${WORKSPACE_ROOT}" --product %q "$@"\n' \
                "${relative}" "${MONUTCHEE_PRODUCT}"
        } > "${WORKSPACE_ROOT}/${relative}"
        chmod +x -- "${WORKSPACE_ROOT}/${relative}"
    done
    create_build_script_updater || return 1

    printf 'Build-stage scripts are ready:\n'
    printf '  %s/{make_PL.sh,make_mconf.sh,make_RPU.sh,make_yocto.sh}\n' "${WORKSPACE_ROOT}"
    printf '  %s/updateBuildScripts.sh\n' "${WORKSPACE_ROOT}"
}

create_tmux_launcher() {
    local launcher="${WORKSPACE_ROOT}/openTmux"

    # The product-specific values are expanded here into the launcher header;
    # the static body below is a quoted heredoc that references them at runtime.
    {
        printf '#!/usr/bin/env bash\n\n'
        printf 'set -Eeuo pipefail\n\n'
        printf '# Generated by setupWorkspace. Opens a "%s" tmux session with one\n' "${TMUX_SESSION}"
        printf '# window per component. Run it from anywhere in the workspace root.\n\n'
        printf 'SESSION=%q\n' "${TMUX_SESSION}"
        printf 'PROJECT_PREFIX=%q\n' "${PROJECT_PREFIX}"
        printf 'WEB_PROJECT_NAME=%q\n' "${WEB_PROJECT_NAME}"
        printf 'APPLICATIONS_DIR=%q\n' "${APPLICATIONS_DIR_NAME}"
        printf 'YOCTO_DIR=%q\n' "${YOCTO_DIR_NAME}"
        printf 'YOCTO_BUILD_DIR=%q\n\n' "${YOCTO_BUILD_DIR}"
        cat <<'BODY'
WORKSPACE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

if ! command -v tmux >/dev/null 2>&1; then
    printf 'Error: tmux was not found in PATH.\n' >&2
    exit 1
fi

# If the session already exists, just attach to (or switch to) it.
if tmux has-session -t "${SESSION}" 2>/dev/null; then
    printf 'Session %s already exists; attaching.\n' "${SESSION}"
    if [[ -n "${TMUX:-}" ]]; then
        exec tmux switch-client -t "${SESSION}"
    else
        exec tmux attach-session -t "${SESSION}"
    fi
fi

open_window() {
    # open_window <name> <directory>
    local name="$1"
    local dir="$2"

    if [[ ! -d "${dir}" ]]; then
        printf 'Warning: %s does not exist yet; opening %s in workspace root.\n' \
            "${dir}" "${name}" >&2
        dir="${WORKSPACE_ROOT}"
    fi

    if [[ -z "${SESSION_CREATED:-}" ]]; then
        tmux new-session -d -s "${SESSION}" -n "${name}" -c "${dir}"
        SESSION_CREATED=1
    else
        tmux new-window -t "${SESSION}:" -n "${name}" -c "${dir}"
    fi
}

open_window root "${WORKSPACE_ROOT}"
open_window yocto "${WORKSPACE_ROOT}/${YOCTO_DIR}/sources/meta-monutchee"

# Keep meta-monutchee in the upper two-thirds of the Yocto window. The new
# lower pane preserves the original Yocto console and SDK initialization.
YOCTO_WINDOW_HEIGHT="$(
    tmux display-message -p -t "${SESSION}:yocto" '#{window_height}' \
        2>/dev/null || printf '24\n'
)"
if [[ ! "${YOCTO_WINDOW_HEIGHT}" =~ ^[0-9]+$ ]]; then
    YOCTO_WINDOW_HEIGHT=24
fi
YOCTO_BOTTOM_HEIGHT=$((YOCTO_WINDOW_HEIGHT / 3))
if ((YOCTO_BOTTOM_HEIGHT < 1)); then
    YOCTO_BOTTOM_HEIGHT=1
fi

YOCTO_SDK_PANE=""
if ! YOCTO_SDK_PANE="$(
    tmux split-window \
        -P -F '#{pane_id}' \
        -v -l "${YOCTO_BOTTOM_HEIGHT}" \
        -t "${SESSION}:yocto" \
        -c "${WORKSPACE_ROOT}/${YOCTO_DIR}"
)"; then
    printf 'Warning: failed to split the yocto window; using one pane.\n' >&2
    YOCTO_SDK_PANE="$(
        tmux display-message -p -t "${SESSION}:yocto" '#{pane_id}'
    )"
fi
if [[ -e "${WORKSPACE_ROOT}/${YOCTO_DIR}/setupSDK" ]]; then
    tmux send-keys -t "${YOCTO_SDK_PANE}" 'source ./setupSDK' C-m
else
    printf 'Warning: %s/setupSDK not found; skipping source.\n' "${YOCTO_DIR}" >&2
fi

open_window apu  "${WORKSPACE_ROOT}/${APPLICATIONS_DIR}/${PROJECT_PREFIX}_APU"
open_window rpu  "${WORKSPACE_ROOT}/${APPLICATIONS_DIR}/${PROJECT_PREFIX}_RPU"
open_window pl   "${WORKSPACE_ROOT}/${APPLICATIONS_DIR}/${PROJECT_PREFIX}_PL"
if [[ -n "${WEB_PROJECT_NAME}" ]]; then
    open_window web "${WORKSPACE_ROOT}/${APPLICATIONS_DIR}/${WEB_PROJECT_NAME}"
fi
open_window tftp "${WORKSPACE_ROOT}/${YOCTO_DIR}/${YOCTO_BUILD_DIR}/export/tftpboot"

# Start on the workspace-root window.
tmux select-window -t "${SESSION}:root"

if [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "${SESSION}"
else
    exec tmux attach-session -t "${SESSION}"
fi
BODY
    } >"${launcher}"

    chmod +x -- "${launcher}"

    printf 'tmux launcher is ready:\n'
    printf '  %s\n' "${launcher}"
}

setup_applications() {
    local applications_root="${WORKSPACE_ROOT}/${APPLICATIONS_DIR_NAME}"
    local -a projects=()
    local -a selected_projects=()
    local -a projects_to_start=()
    local project_name
    local sync_products=false

    if ! command -v repo >/dev/null 2>&1; then
        printf 'Error: repo command was not found in PATH.\n' >&2
        return 1
    fi

    mkdir -p -- "${applications_root}"

    # A legacy applications directory has component clones but no repo
    # metadata. Refuse to adopt it implicitly because repo may otherwise move
    # or replace Git metadata while synchronizing.
    if [[ ! -d "${applications_root}/.repo" ]]; then
        for project_name in \
            "${APU_PROJECT_NAME}" \
            "${RPU_PROJECT_NAME}" \
            "${PL_PROJECT_NAME}" \
            "${WEB_PROJECT_NAME}"; do
            if [[ -n "${project_name}" && -e "${applications_root}/${project_name}" ]]; then
                printf 'Error: %s already exists but applications has no .repo.\n' \
                    "${applications_root}/${project_name}" >&2
                printf 'Create a fresh workspace or migrate the existing checkout manually.\n' >&2
                return 1
            fi
        done
    fi

    if [[ "${DO_ALL}" == true ]]; then
        selected_projects+=(
            "${APU_PROJECT_NAME}"
            "${RPU_PROJECT_NAME}"
            "${PL_PROJECT_NAME}"
        )
        if [[ -n "${WEB_PROJECT_NAME}" ]]; then
            selected_projects+=("${WEB_PROJECT_NAME}")
        fi
    else
        [[ "${DO_APU}" == true ]] && projects+=("${APU_PROJECT_NAME}")
        [[ "${DO_RPU}" == true ]] && projects+=("${RPU_PROJECT_NAME}")
        [[ "${DO_PL}" == true ]] && projects+=("${PL_PROJECT_NAME}")
        [[ "${DO_WEB}" == true ]] && projects+=("${WEB_PROJECT_NAME}")
        selected_projects=("${projects[@]}")
    fi
    for project_name in "${selected_projects[@]}"; do
        if [[ ! -e "${applications_root}/${project_name}/.git" ]]; then
            projects_to_start+=("${project_name}")
        fi
    done
    if [[ "${DO_ALL}" == true || "${DO_APU}" == true || \
          "${DO_RPU}" == true || "${DO_PL}" == true || \
          "${DO_WEB}" == true ]]; then
        sync_products=true
    fi

    printf 'Initializing applications repo client:\n'
    printf '  product:             %s\n' "${MONUTCHEE_PRODUCT}"
    printf '  manifest repository: %s\n' "${MANIFEST_REPO_URL}"
    printf '  manifest branch:     %s\n' "${MANIFEST_BRANCH}"
    printf '  manifest file:       %s\n' "${APPLICATIONS_MANIFEST_FILE}"
    printf '  destination:         %s\n' "${applications_root}"

    (
        cd "${applications_root}"

        repo init \
            -u "${MANIFEST_REPO_URL}" \
            -b "${MANIFEST_BRANCH}" \
            -m "${APPLICATIONS_MANIFEST_FILE}" \
            || exit 1

        if [[ "${sync_products}" != true ]]; then
            exit 0
        fi

        # Fetch submodules for build completeness without registering them as
        # manifest projects. Branch operations therefore affect only projects
        # declared by applications.xml.
        repo sync --fetch-submodules \
            "${projects[@]}" || exit 1

        # Repo normally leaves newly synchronized projects detached at the
        # manifest revision. Attach only new checkouts so a later setup run
        # never replaces a developer's active branch.
        if ((${#projects_to_start[@]} > 0)); then
            repo start "${PRODUCT_BRANCH}" "${projects_to_start[@]}" || exit 1
        fi
    ) || return 1

    # A filtered first sync may not discover a submodule until after its
    # parent worktree exists. Complete the owning repositories explicitly so
    # focused `apu` and `rpu` setup is as complete as `all`.
    if [[ "${DO_ALL}" == true || "${DO_APU}" == true ]]; then
        git -C "${applications_root}/${APU_PROJECT_NAME}" \
            submodule update --init --recursive || return 1
    fi
    if [[ "${DO_ALL}" == true || "${DO_RPU}" == true ]]; then
        git -C "${applications_root}/${RPU_PROJECT_NAME}" \
            submodule update --init --recursive || return 1
    fi

    if [[ "${sync_products}" == true ]]; then
        printf 'Applications synchronized successfully.\n'
    else
        printf 'Applications manifest initialized successfully.\n'
    fi
}

setup_yocto() {
    local yocto_dir="${WORKSPACE_ROOT}/${YOCTO_DIR_NAME}"
    local meta_monutchee_dir="${yocto_dir}/sources/meta-monutchee"
    local start_meta_monutchee=false

    if ! command -v repo >/dev/null 2>&1; then
        printf 'Error: repo command was not found in PATH.\n' >&2
        return 1
    fi

    if [[ ! -e "${meta_monutchee_dir}/.git" ]]; then
        start_meta_monutchee=true
    fi

    mkdir -p -- "${yocto_dir}"

    printf 'Synchronizing Yocto repo client:\n'
    printf '  product:             %s\n' "${MONUTCHEE_PRODUCT}"
    printf '  manifest repository: %s\n' "${MANIFEST_REPO_URL}"
    printf '  manifest branch:     %s\n' "${MANIFEST_BRANCH}"
    printf '  manifest file:       %s\n' "${YOCTO_MANIFEST_FILE}"
    printf '  destination:         %s\n' "${yocto_dir}"

    (
        cd "${yocto_dir}"
        repo init \
            -u "${MANIFEST_REPO_URL}" \
            -b "${MANIFEST_BRANCH}" \
            -m "${YOCTO_MANIFEST_FILE}" || exit 1
        repo sync || exit 1
    ) || return 1

    if [[ "${META_MONUTCHEE_BRANCH}" == "main" && \
          "${start_meta_monutchee}" == true ]]; then
        (
            cd "${yocto_dir}"
            repo start main sources/meta-monutchee || exit 1
        ) || return 1
    elif [[ "${META_MONUTCHEE_BRANCH}" != "main" ]]; then
        clone_or_checkout_branch_in_place() {
            local repository="$1"
            local remote="$2"
            local branch="$3"
            if git -C "${repository}" show-ref --verify --quiet "refs/heads/${branch}"; then
                git -C "${repository}" switch "${branch}"
            else
                git -C "${repository}" fetch "${remote}" "${branch}" &&
                    git -C "${repository}" switch --track "${remote}/${branch}"
            fi
        }
        clone_or_checkout_branch_in_place \
            "${meta_monutchee_dir}" Monutchee "${META_MONUTCHEE_BRANCH}" \
            || return 1
    fi

    # Record the product so `source ./setupSDK` works with no argument in every
    # new console.
    printf '%s\n' "${MONUTCHEE_PRODUCT}" > "${yocto_dir}/.mncos-product"
    printf 'Recorded product marker: %s (%s)\n' \
        "${MONUTCHEE_PRODUCT}" "${yocto_dir}/.mncos-product"

    printf 'Yocto workspace synchronized successfully.\n'
}

main() {
    local failures=0

    parse_arguments "$@"
    validate_manifest_branch
    configure_product

    mkdir -p -- "${WORKSPACE_ROOT}"
    WORKSPACE_ROOT="$(cd -- "${WORKSPACE_ROOT}" && pwd -P)"
    select_automatic_mode
    mkdir -p -- \
        "${WORKSPACE_ROOT}/${APPLICATIONS_DIR_NAME}" \
        "${WORKSPACE_ROOT}/${YOCTO_DIR_NAME}"

    printf 'Product:        %s\n' "${MONUTCHEE_PRODUCT}"
    printf 'Workspace root: %s\n\n' "${WORKSPACE_ROOT}"

    install_workspace_guidance
    printf '\n'

    create_runtime_directories
    printf '\n'

    if [[ "${MONUTCHEE_SCRIPTS_ONLY_UPDATE:-false}" != true ]]; then
        create_tmux_launcher
        printf '\n'
    fi

    if [[ "${DO_SCRIPTS}" == true ]]; then
        install_build_scripts || failures=$((failures + 1))
        printf '\n'
    fi

    if [[ "${DO_ALL}" == true || "${DO_APU}" == true || \
          "${DO_RPU}" == true || "${DO_PL}" == true || \
          "${DO_WEB}" == true ]]; then
        setup_applications || failures=$((failures + 1))
        printf '\n'
    fi

    if [[ "${DO_YOCTO}" == true ]]; then
        setup_yocto || failures=$((failures + 1))
        printf '\n'
    fi

    if ((failures > 0)); then
        printf 'Workspace setup completed with %d failed component(s).\n' \
            "${failures}" >&2
        exit 1
    fi

    if [[ "${AUTO_MODE}" == true || "${DO_ALL}" == true ]]; then
        record_workspace_product
    fi

    printf 'Workspace setup completed successfully.\n'
}

main "$@"
